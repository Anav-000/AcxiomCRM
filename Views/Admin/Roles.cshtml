@{
    ViewData["Title"] = "Roles & Permissions";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="h3 mb-0">Role & Permission Matrix</h2>
        <span class="text-muted">AcxiomCRM Role-Based Authorization Policy (Section 7.1)</span>
    </div>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-4">
        <p class="text-muted">
            The system implements three discrete access tiers with server-side authorization enforcement across MVC actions, queries, form bindings, and REST APIs.
        </p>

        <div class="table-responsive">
            <table class="table table-bordered table-striped align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 20%;">Module</th>
                        <th style="width: 25%;">Admin</th>
                        <th style="width: 30%;">Manager</th>
                        <th style="width: 25%;">Sales Executive</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold">Dashboard</td>
                        <td><span class="badge bg-success">Full System Visibility</span></td>
                        <td><span class="badge bg-warning text-dark">Team Pipeline & KPIs</span></td>
                        <td><span class="badge bg-primary">Assigned / Own Records</span></td>
                    </tr>
                    <tr>
                        <td class="fw-bold">Customers</td>
                        <td><span class="badge bg-success">Full (All Records)</span></td>
                        <td><span class="badge bg-warning text-dark">Team / Business Scope</span></td>
                        <td><span class="badge bg-primary">Own / Assigned Only</span></td>
                    </tr>
                    <tr>
                        <td class="fw-bold">Leads</td>
                        <td><span class="badge bg-success">Full (All Records)</span></td>
                        <td><span class="badge bg-warning text-dark">Team Leads</span></td>
                        <td><span class="badge bg-primary">Own / Assigned Only</span></td>
                    </tr>
                    <tr>
                        <td class="fw-bold">Opportunities</td>
                        <td><span class="badge bg-success">Full (All Records)</span></td>
                        <td><span class="badge bg-warning text-dark">Team Opportunities</span></td>
                        <td><span class="badge bg-primary">Own / Assigned Only</span></td>
                    </tr>
                    <tr>
                        <td class="fw-bold">Follow-Ups</td>
                        <td><span class="badge bg-success">Full (All Records)</span></td>
                        <td><span class="badge bg-warning text-dark">Team Follow-Ups</span></td>
                        <td><span class="badge bg-primary">Own / Assigned Only</span></td>
                    </tr>
                    <tr>
                        <td class="fw-bold">Activities</td>
                        <td><span class="badge bg-success">Full (All Records)</span></td>
                        <td><span class="badge bg-warning text-dark">Team Activities</span></td>
                        <td><span class="badge bg-primary">Own / Assigned Only</span></td>
                    </tr>
                    <tr>
                        <td class="fw-bold">User Management</td>
                        <td><span class="badge bg-success">Full Administration</span></td>
                        <td><span class="badge bg-secondary">No Access</span></td>
                        <td><span class="badge bg-secondary">No Access</span></td>
                    </tr>
                    <tr>
                        <td class="fw-bold">Role Management</td>
                        <td><span class="badge bg-success">Full Administration</span></td>
                        <td><span class="badge bg-secondary">No Access</span></td>
                        <td><span class="badge bg-secondary">No Access</span></td>
                    </tr>
                    <tr>
                        <td class="fw-bold">Audit Logs</td>
                        <td><span class="badge bg-success">Full System Logs</span></td>
                        <td><span class="badge bg-secondary">Restricted View</span></td>
                        <td><span class="badge bg-secondary">No Access</span></td>
                    </tr>
                    <tr>
                        <td class="fw-bold">REST API</td>
                        <td><span class="badge bg-success">Authorized Endpoints</span></td>
                        <td><span class="badge bg-warning text-dark">Authorized Endpoints</span></td>
                        <td><span class="badge bg-primary">Authorized Endpoints</span></td>
                    </tr>
                    <tr>
                        <td class="fw-bold">Reports</td>
                        <td><span class="badge bg-success">All 8 Reports (Full)</span></td>
                        <td><span class="badge bg-warning text-dark">Management / Team Reports</span></td>
                        <td><span class="badge bg-primary">Assigned Reports Only</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
