@model AcxiomCRM.ViewModels.AdminUserEditViewModel
@{
    ViewData["Title"] = "Edit User";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card shadow-sm">
            <div class="card-header bg-white py-3">
                <h4 class="card-title mb-0">Edit User & Role</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="UserEdit" method="post">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="Email" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label class="form-label text-muted">Email (Username)</label>
                        <input type="text" class="form-control" value="@Model.Email" disabled />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold">Full Name</label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Role" class="form-label fw-semibold">Primary Role</label>
                        <select asp-for="Role" asp-items="Model.AvailableRoles" class="form-select">
                        </select>
                        <span asp-validation-for="Role" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ManagerId" class="form-label fw-semibold">Assigned Manager (Optional)</label>
                        <select asp-for="ManagerId" asp-items="Model.AvailableManagers" class="form-select">
                            <option value="">-- No Direct Manager --</option>
                        </select>
                        <span asp-validation-for="ManagerId" class="text-danger small"></span>
                    </div>

                    <div class="form-check form-switch mb-4">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" id="isActiveSwitch" />
                        <label class="form-check-label fw-semibold" for="isActiveSwitch">Account Active</label>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Users" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
