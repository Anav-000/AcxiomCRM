@model AcxiomCRM.ViewModels.OpportunityDetailsViewModel
@{
    ViewData["Title"] = "Opportunity Details";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h4 class="card-title mb-0">@Model.Opportunity.OpportunityName</h4>
                <div>
                    @switch (Model.Opportunity.Stage)
                    {
                        case "Qualification":
                            <span class="badge bg-info text-dark fs-6">Qualification</span>
                            break;
                        case "Proposal":
                            <span class="badge bg-primary fs-6">Proposal</span>
                            break;
                        case "Negotiation":
                            <span class="badge bg-warning text-dark fs-6">Negotiation</span>
                            break;
                        case "Won":
                            <span class="badge bg-success fs-6">Won</span>
                            break;
                        case "Lost":
                            <span class="badge bg-danger fs-6">Lost</span>
                            break;
                        default:
                            <span class="badge bg-secondary fs-6">@Model.Opportunity.Stage</span>
                            break;
                    }
                    <span class="badge bg-dark fs-6 ms-1">@Model.Opportunity.Status</span>
                </div>
            </div>
            <div class="card-body p-4">
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <label class="text-muted small">Amount</label>
                        <div class="h4 text-primary">@Model.Opportunity.Amount.ToString("C")</div>
                    </div>
                    <div class="col-md-4">
                        <label class="text-muted small">Probability</label>
                        <div class="h4">@Model.Opportunity.Probability %</div>
                    </div>
                    <div class="col-md-4">
                        <label class="text-muted small">Weighted Pipeline Value</label>
                        <div class="h4 text-info">@Model.Opportunity.WeightedValue.ToString("C")</div>
                    </div>
                </div>

                <hr />

                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">Customer</dt>
                    <dd class="col-sm-8">
                        @if (Model.Opportunity.Customer != null)
                        {
                            <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.Opportunity.CustomerId" class="fw-semibold">
                                @Model.Opportunity.Customer.CustomerName
                            </a>
                        }
                        else
                        {
                            <span class="text-muted">None</span>
                        }
                    </dd>

                    <dt class="col-sm-4 text-muted">Lead</dt>
                    <dd class="col-sm-8">
                        @if (Model.Opportunity.Lead != null)
                        {
                            <a asp-controller="Leads" asp-action="Details" asp-route-id="@Model.Opportunity.LeadId" class="fw-semibold">
                                @Model.Opportunity.Lead.LeadName
                            </a>
                        }
                        else
                        {
                            <span class="text-muted">None</span>
                        }
                    </dd>

                    <dt class="col-sm-4 text-muted">Expected Close Date</dt>
                    <dd class="col-sm-8">@Model.Opportunity.ExpectedCloseDate.ToString("yyyy-MM-dd")</dd>

                    <dt class="col-sm-4 text-muted">Assigned Owner</dt>
                    <dd class="col-sm-8">@(Model.Opportunity.AssignedTo ?? "Unassigned")</dd>

                    <dt class="col-sm-4 text-muted">Created Date</dt>
                    <dd class="col-sm-8">@Model.Opportunity.CreatedDate.ToString("g")</dd>
                </dl>
            </div>
            <div class="card-footer bg-white py-3 d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
                <div>
                    @if (Model.CanEdit)
                    {
                        <a asp-action="Edit" asp-route-id="@Model.Opportunity.OpportunityId" class="btn btn-primary me-2">Edit</a>
                    }
                    @if (Model.CanDelete)
                    {
                        <a asp-action="Delete" asp-route-id="@Model.Opportunity.OpportunityId" class="btn btn-outline-danger">Delete</a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
