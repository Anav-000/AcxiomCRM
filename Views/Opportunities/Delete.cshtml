@model AcxiomCRM.Models.Opportunity
@{
    ViewData["Title"] = "Delete Opportunity";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card border-danger shadow-sm">
            <div class="card-header bg-danger text-white py-3">
                <h4 class="card-title mb-0">Confirm Delete Opportunity</h4>
            </div>
            <div class="card-body p-4">
                <p class="lead">Are you sure you want to soft delete this opportunity?</p>
                
                <div class="bg-light p-3 rounded mb-3">
                    <p class="mb-1"><strong>Opportunity:</strong> @Model.OpportunityName</p>
                    <p class="mb-1"><strong>Amount:</strong> @Model.Amount.ToString("C")</p>
                    <p class="mb-1"><strong>Stage:</strong> @Model.Stage</p>
                    <p class="mb-0"><strong>Status:</strong> @Model.Status</p>
                </div>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="OpportunityId" />
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-danger">Confirm Delete</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
