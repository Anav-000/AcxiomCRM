@model AcxiomCRM.ViewModels.OpportunityCreateEditViewModel
@{
    ViewData["Title"] = "Create Opportunity";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header bg-white py-3">
                <h4 class="card-title mb-0">Create Opportunity</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="OpportunityName" class="form-label fw-semibold"></label>
                        <input asp-for="OpportunityName" class="form-control" placeholder="e.g. Enterprise Cloud Migration" />
                        <span asp-validation-for="OpportunityName" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="CustomerId" class="form-label fw-semibold"></label>
                            <select asp-for="CustomerId" asp-items="Model.AvailableCustomers" class="form-select">
                                <option value="">-- Select Customer --</option>
                            </select>
                            <span asp-validation-for="CustomerId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LeadId" class="form-label fw-semibold"></label>
                            <select asp-for="LeadId" asp-items="Model.AvailableLeads" class="form-select">
                                <option value="">-- Select Lead (Optional) --</option>
                            </select>
                            <span asp-validation-for="LeadId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label asp-for="Amount" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="Amount" type="number" step="0.01" class="form-control" />
                            </div>
                            <span asp-validation-for="Amount" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Stage" class="form-label fw-semibold"></label>
                            <select asp-for="Stage" asp-items="Model.AvailableStages" class="form-select">
                            </select>
                            <span asp-validation-for="Stage" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Probability" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <input asp-for="Probability" type="number" min="0" max="100" class="form-control" />
                                <span class="input-group-text">%</span>
                            </div>
                            <span asp-validation-for="Probability" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="ExpectedCloseDate" class="form-label fw-semibold"></label>
                            <input asp-for="ExpectedCloseDate" type="date" class="form-control" />
                            <span asp-validation-for="ExpectedCloseDate" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="AssignedTo" class="form-label fw-semibold"></label>
                            @if (Model.CanReassign)
                            {
                                <select asp-for="AssignedTo" asp-items="Model.AssignableUsers" class="form-select">
                                </select>
                            }
                            else
                            {
                                <input type="text" class="form-control" value="@Model.AssignedTo" disabled />
                                <input type="hidden" asp-for="AssignedTo" />
                            }
                            <span asp-validation-for="AssignedTo" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4">Create Opportunity</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
