@model AcxiomCRM.ViewModels.PipelineReportViewModel
@{
    ViewData["Title"] = "Pipeline Report";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="h3 mb-0">Pipeline Report</h2>
        <span class="text-muted">Stage-wise and owner-wise pipeline distributions (Section 11)</span>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">&larr; Back to Reports</a>
</div>

<!-- Metrics Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card shadow-sm border-0 border-start border-primary border-4">
            <div class="card-body">
                <div class="text-muted small fw-semibold">Open Pipeline Total</div>
                <div class="h3 text-primary mb-0 mt-1">@Model.TotalOpenAmount.ToString("C")</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0 border-start border-info border-4">
            <div class="card-body">
                <div class="text-muted small fw-semibold">Weighted Pipeline (Forecast)</div>
                <div class="h3 text-info mb-0 mt-1">@Model.TotalWeightedAmount.ToString("C")</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0 border-start border-success border-4">
            <div class="card-body">
                <div class="text-muted small fw-semibold">Closed Won Total</div>
                <div class="h3 text-success mb-0 mt-1">@Model.TotalWonAmount.ToString("C")</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Stage-wise Distribution -->
    <div class="col-md-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3">
                <h5 class="fw-bold mb-0">Stage-wise Distribution</h5>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Stage</th>
                            <th class="text-center">Count</th>
                            <th class="text-end">Total Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var stage in Model.StageAmounts)
                        {
                            <tr>
                                <td class="fw-semibold">@stage.Key</td>
                                <td class="text-center">@(Model.StageCounts.ContainsKey(stage.Key) ? Model.StageCounts[stage.Key] : 0)</td>
                                <td class="text-end fw-bold">@stage.Value.ToString("C")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Owner-wise Distribution -->
    <div class="col-md-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3">
                <h5 class="fw-bold mb-0">Owner-wise Open Pipeline</h5>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Account Owner</th>
                            <th class="text-end">Open Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var owner in Model.OwnerAmounts)
                        {
                            <tr>
                                <td class="fw-semibold">@owner.Key</td>
                                <td class="text-end fw-bold text-primary">@owner.Value.ToString("C")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
