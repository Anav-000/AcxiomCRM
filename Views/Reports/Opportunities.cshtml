@model AcxiomCRM.ViewModels.OpportunityReportViewModel
@{
    ViewData["Title"] = "Opportunity Report";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="h3 mb-0">Opportunity Report</h2>
        <span class="text-muted">Pipeline stages, amounts, probability, and weighted forecast values (Section 11)</span>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">&larr; Back to Reports</a>
</div>

<!-- Metrics Summary -->
<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card shadow-sm border-0 border-start border-primary border-4">
            <div class="card-body">
                <div class="text-muted small fw-semibold">Total Opportunity Value</div>
                <div class="h3 text-primary mb-0 mt-1">@Model.TotalAmount.ToString("C")</div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm border-0 border-start border-info border-4">
            <div class="card-body">
                <div class="text-muted small fw-semibold">Total Weighted Value (Forecast)</div>
                <div class="h3 text-info mb-0 mt-1">@Model.TotalWeightedValue.ToString("C")</div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Opportunity</th>
                    <th>Customer</th>
                    <th>Stage</th>
                    <th>Status</th>
                    <th class="text-end">Amount</th>
                    <th class="text-center">Probability</th>
                    <th class="text-end">Weighted Value</th>
                    <th>Expected Close</th>
                    <th>Owner</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in Model.Opportunities)
                {
                    <tr>
                        <td class="fw-semibold">@o.OpportunityName</td>
                        <td>@(o.Customer?.CustomerName ?? "—")</td>
                        <td>
                            @switch (o.Stage)
                            {
                                case "Qualification":
                                    <span class="badge bg-info text-dark">Qualification</span>
                                    break;
                                case "Proposal":
                                    <span class="badge bg-primary">Proposal</span>
                                    break;
                                case "Negotiation":
                                    <span class="badge bg-warning text-dark">Negotiation</span>
                                    break;
                                case "Won":
                                    <span class="badge bg-success">Won</span>
                                    break;
                                case "Lost":
                                    <span class="badge bg-danger">Lost</span>
                                    break;
                                default:
                                    <span class="badge bg-secondary">@o.Stage</span>
                                    break;
                            }
                        </td>
                        <td>
                            <span class="badge @(o.Status == "Won" ? "bg-success" : o.Status == "Lost" ? "bg-danger" : "bg-primary")">@o.Status</span>
                        </td>
                        <td class="text-end fw-semibold">@o.Amount.ToString("C")</td>
                        <td class="text-center">@o.Probability %</td>
                        <td class="text-end text-muted">@o.WeightedValue.ToString("C")</td>
                        <td>@o.ExpectedCloseDate.ToString("yyyy-MM-dd")</td>
                        <td><small>@(o.AssignedTo ?? "Unassigned")</small></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
