@model AcxiomCRM.ViewModels.FollowUpReportViewModel
@{
    ViewData["Title"] = "Follow-Up Report";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="h3 mb-0">Follow-Up Report</h2>
        <span class="text-muted">Planned, completed, missed, and overdue touchpoint tracking (Section 11)</span>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">&larr; Back to Reports</a>
</div>

<!-- Metrics Summary -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card shadow-sm border-0 border-start border-warning border-4">
            <div class="card-body">
                <div class="text-muted small fw-semibold">Planned Follow-Ups</div>
                <div class="h3 text-warning mb-0 mt-1">@Model.TotalPlanned</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0 border-start border-success border-4">
            <div class="card-body">
                <div class="text-muted small fw-semibold">Completed</div>
                <div class="h3 text-success mb-0 mt-1">@Model.TotalCompleted</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0 border-start border-danger border-4">
            <div class="card-body">
                <div class="text-muted small fw-semibold">Overdue</div>
                <div class="h3 text-danger mb-0 mt-1">@Model.TotalOverdue</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0 border-start border-secondary border-4">
            <div class="card-body">
                <div class="text-muted small fw-semibold">Cancelled</div>
                <div class="h3 text-secondary mb-0 mt-1">@Model.TotalCancelled</div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Date</th>
                    <th>Type</th>
                    <th>Related Customer / Lead</th>
                    <th>Remarks</th>
                    <th>Status</th>
                    <th>Assigned Owner</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var f in Model.FollowUps)
                {
                    var isOverdue = f.Status == "Planned" && f.FollowUpDate.Date < DateTime.Today;
                    <tr class="@(isOverdue ? "table-danger" : "")">
                        <td class="fw-bold">
                            @f.FollowUpDate.ToString("yyyy-MM-dd")
                            @if (isOverdue)
                            {
                                <span class="badge bg-danger ms-1">OVERDUE</span>
                            }
                        </td>
                        <td><span class="badge bg-secondary">@f.FollowUpType</span></td>
                        <td>
                            @(f.Customer?.CustomerName ?? f.Lead?.LeadName ?? f.Opportunity?.OpportunityName ?? "—")
                        </td>
                        <td class="small text-truncate" style="max-width: 250px;">@(f.Remarks ?? "—")</td>
                        <td>
                            @switch (f.Status)
                            {
                                case "Completed":
                                    <span class="badge bg-success">Completed</span>
                                    break;
                                case "Planned":
                                    <span class="badge bg-warning text-dark">Planned</span>
                                    break;
                                default:
                                    <span class="badge bg-secondary">@f.Status</span>
                                    break;
                            }
                        </td>
                        <td><small>@(f.AssignedTo ?? "Unassigned")</small></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
