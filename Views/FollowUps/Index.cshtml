@model AcxiomCRM.ViewModels.FollowUpListViewModel
@{
    ViewData["Title"] = "Follow-Ups";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="h3 mb-0">Follow-Up Management</h2>
        <span class="text-muted">Schedule, reschedule, and complete client engagements</span>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-calendar-plus me-1"></i> Schedule Follow-Up
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Metrics summary cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card shadow-sm border-0 border-start border-warning border-4">
            <div class="card-body">
                <div class="text-muted small fw-semibold">Pending / Planned</div>
                <div class="h3 text-warning mb-0 mt-1">@Model.TotalPlannedCount</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0 border-start border-danger border-4">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold">Overdue Items</div>
                    <div class="h3 text-danger mb-0 mt-1">@Model.TotalOverdueCount</div>
                </div>
                @if (Model.TotalOverdueCount > 0)
                {
                    <a asp-action="Index" asp-route-overdueOnly="true" class="btn btn-sm btn-outline-danger">View Overdue</a>
                }
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0 border-start border-success border-4">
            <div class="card-body">
                <div class="text-muted small fw-semibold">Completed Follow-Ups</div>
                <div class="h3 text-success mb-0 mt-1">@Model.TotalCompletedCount</div>
            </div>
        </div>
    </div>
</div>

<!-- Filters -->
<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-3">
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Status</label>
                <select name="statusFilter" asp-items="Model.StatusList" class="form-select">
                    <option value="">All Statuses</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Type</label>
                <select name="followUpTypeFilter" asp-items="Model.TypeList" class="form-select">
                    <option value="">All Types</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Date</label>
                <input type="date" name="dateFilter" value="@(Model.DateFilter?.ToString("yyyy-MM-dd"))" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Owner</label>
                <select name="ownerFilter" asp-items="Model.UserList" class="form-select">
                    <option value="">All Owners</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Customer</label>
                <select name="customerIdFilter" asp-items="Model.CustomerList" class="form-select">
                    <option value="">All Customers</option>
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-outline-primary w-100 me-2">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Table -->
<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Date</th>
                    <th>Type</th>
                    <th>Linked Record</th>
                    <th>Remarks</th>
                    <th>Status</th>
                    <th>Assigned To</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.FollowUps.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">No follow-ups found.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model.FollowUps)
                    {
                        <tr class="@(item.IsOverdue ? "table-danger" : "")">
                            <td>
                                <span class="fw-bold">@item.FollowUpDate.ToString("yyyy-MM-dd")</span>
                                @if (item.IsOverdue)
                                {
                                    <span class="badge bg-danger ms-1">OVERDUE</span>
                                }
                            </td>
                            <td>
                                <span class="badge bg-secondary">@item.FollowUpType</span>
                            </td>
                            <td>
                                @if (item.CustomerId.HasValue)
                                {
                                    <div><small class="text-muted">Customer:</small> <strong>@item.CustomerName</strong></div>
                                }
                                @if (item.LeadId.HasValue)
                                {
                                    <div><small class="text-muted">Lead:</small> <strong>@item.LeadName</strong></div>
                                }
                                @if (item.OpportunityId.HasValue)
                                {
                                    <div><small class="text-muted">Opp:</small> <strong>@item.OpportunityName</strong></div>
                                }
                                @if (!item.CustomerId.HasValue && !item.LeadId.HasValue && !item.OpportunityId.HasValue)
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                <span class="small text-truncate d-inline-block" style="max-width: 250px;">
                                    @(string.IsNullOrWhiteSpace(item.Remarks) ? "—" : item.Remarks)
                                </span>
                            </td>
                            <td>
                                @switch (item.Status)
                                {
                                    case "Planned":
                                        <span class="badge bg-warning text-dark">Planned</span>
                                        break;
                                    case "Completed":
                                        <span class="badge bg-success">Completed</span>
                                        break;
                                    case "Cancelled":
                                        <span class="badge bg-secondary">Cancelled</span>
                                        break;
                                    default:
                                        <span class="badge bg-light text-dark">@item.Status</span>
                                        break;
                                }
                            </td>
                            <td>
                                <small>@item.AssignedToName</small>
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    @if (item.Status == "Planned")
                                    {
                                        <form asp-action="Complete" asp-route-id="@item.FollowUpId" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-success" title="Mark Completed">
                                                <i class="bi bi-check-lg"></i>
                                            </button>
                                        </form>
                                    }
                                    <a asp-action="Details" asp-route-id="@item.FollowUpId" class="btn btn-outline-info" title="Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.FollowUpId" class="btn btn-outline-primary" title="Edit/Reschedule">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.FollowUpId" class="btn btn-outline-danger" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
