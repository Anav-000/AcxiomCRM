@model AcxiomCRM.Models.FollowUp
@{
    ViewData["Title"] = "Delete Follow-Up";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card border-danger shadow-sm">
            <div class="card-header bg-danger text-white py-3">
                <h4 class="card-title mb-0">Confirm Delete Follow-Up</h4>
            </div>
            <div class="card-body p-4">
                <p class="lead">Are you sure you want to soft delete this follow-up?</p>

                <div class="bg-light p-3 rounded mb-3">
                    <p class="mb-1"><strong>Follow-Up #:</strong> @Model.FollowUpId</p>
                    <p class="mb-1"><strong>Type:</strong> @Model.FollowUpType</p>
                    <p class="mb-1"><strong>Date:</strong> @Model.FollowUpDate.ToString("yyyy-MM-dd")</p>
                    <p class="mb-0"><strong>Status:</strong> @Model.Status</p>
                </div>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="FollowUpId" />
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-danger">Confirm Delete</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
