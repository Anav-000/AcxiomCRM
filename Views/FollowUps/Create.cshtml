@model AcxiomCRM.ViewModels.FollowUpCreateEditViewModel
@{
    ViewData["Title"] = "Schedule Follow-Up";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header bg-white py-3">
                <h4 class="card-title mb-0">Schedule Follow-Up</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="FollowUpType" class="form-label fw-semibold"></label>
                            <select asp-for="FollowUpType" class="form-select">
                                <option value="Call">Call</option>
                                <option value="Meeting">Meeting</option>
                                <option value="Email">Email</option>
                                <option value="Task">Task</option>
                            </select>
                            <span asp-validation-for="FollowUpType" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="FollowUpDate" class="form-label fw-semibold"></label>
                            <input asp-for="FollowUpDate" type="date" class="form-control" />
                            <span asp-validation-for="FollowUpDate" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label asp-for="CustomerId" class="form-label fw-semibold">Customer (Optional)</label>
                            <select asp-for="CustomerId" asp-items="Model.CustomerList" class="form-select">
                                <option value="">-- Select Customer --</option>
                            </select>
                            <span asp-validation-for="CustomerId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="LeadId" class="form-label fw-semibold">Lead (Optional)</label>
                            <select asp-for="LeadId" asp-items="Model.LeadList" class="form-select">
                                <option value="">-- Select Lead --</option>
                            </select>
                            <span asp-validation-for="LeadId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="OpportunityId" class="form-label fw-semibold">Opportunity (Optional)</label>
                            <select asp-for="OpportunityId" asp-items="Model.OpportunityList" class="form-select">
                                <option value="">-- Select Opportunity --</option>
                            </select>
                            <span asp-validation-for="OpportunityId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label fw-semibold"></label>
                            <select asp-for="Status" class="form-select">
                                <option value="Planned">Planned</option>
                                <option value="Completed">Completed</option>
                                <option value="Cancelled">Cancelled</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="AssignedTo" class="form-label fw-semibold"></label>
                            <select asp-for="AssignedTo" asp-items="Model.UserList" class="form-select">
                                <option value="">-- Select Assignee --</option>
                            </select>
                            <span asp-validation-for="AssignedTo" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Remarks" class="form-label fw-semibold"></label>
                        <textarea asp-for="Remarks" rows="3" class="form-control" placeholder="Discussion points, follow-up objective, action items..."></textarea>
                        <span asp-validation-for="Remarks" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4">Schedule Follow-Up</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
