@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 text-center">
        <div class="card shadow-sm border-0 p-5">
            <div class="display-1 text-danger mb-3">
                <i class="bi bi-shield-x"></i>
            </div>
            <h2 class="fw-bold mb-3">403 - Access Denied</h2>
            <p class="text-muted mb-4">
                You do not have the required role or permissions to access this page.
            </p>
            <div>
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary me-2">
                    <i class="bi bi-speedometer2 me-1"></i> Return to Dashboard
                </a>
                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Switch Account
                </a>
            </div>
        </div>
    </div>
</div>
