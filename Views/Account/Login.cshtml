@model AcxiomCRM.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-5 col-lg-4">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <div class="display-6 text-primary mb-2">
                        <i class="bi bi-shield-lock-fill"></i>
                    </div>
                    <h4 class="fw-bold">Sign In</h4>
                    <p class="text-muted small">Enter your credentials to access AcxiomCRM</p>
                </div>

                <div asp-validation-summary="All" class="alert alert-danger py-2 small" role="alert" style="@(ViewData.ModelState.IsValid ? "display:none" : "")"></div>

                <form asp-controller="Account" asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post" id="loginForm">
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" class="form-control" placeholder="name@example.com" autofocus autocomplete="username" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-key"></i></span>
                            <input asp-for="Password" class="form-control" placeholder="••••••••" autocomplete="current-password" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label small"></label>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                    </button>
                </form>

                <div class="text-center mt-4 border-top pt-3">
                    <span class="text-muted small">Don't have an account?</span>
                    <a asp-controller="Account" asp-action="Register" class="small fw-semibold text-decoration-none ms-1">Register here</a>
                </div>
            </div>
        </div>

        <div class="card bg-white shadow-sm border-0 mt-3">
            <div class="card-body p-3">
                <h6 class="card-subtitle mb-2 text-muted fw-bold small text-uppercase">
                    <i class="bi bi-info-circle me-1 text-primary"></i> Demo Test Accounts
                </h6>
                <div class="small">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="badge bg-danger">Admin</span>
                        <code>admin@acxiomcrm.local / Admin@Password123!</code>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="badge bg-warning text-dark">Manager</span>
                        <code>manager@acxiomcrm.local / Manager@Password123!</code>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="badge bg-primary">SalesExecutive</span>
                        <code>sales@acxiomcrm.local / Sales@Password123!</code>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
