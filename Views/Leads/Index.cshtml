@model AcxiomCRM.ViewModels.LeadListViewModel
@{
    ViewData["Title"] = "Lead Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-funnel-fill text-info me-2"></i>Lead Management</h2>
        <p class="text-muted small mb-0">Capture, qualify, track, and convert prospective client leads.</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i> Capture Lead
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Filters Bar -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-3">
                <input type="text" name="name" value="@Model.NameFilter" class="form-control" placeholder="Filter by Name, Email, Phone..." />
            </div>
            <div class="col-md-3">
                <input type="text" name="company" value="@Model.CompanyFilter" class="form-control" placeholder="Filter by Company..." />
            </div>
            <div class="col-md-2">
                <select name="status" class="form-select">
                    <option value="">All Statuses</option>
                    @foreach (var s in Model.AvailableStatuses)
                    {
                        <option value="@s.Value" selected="@s.Selected">@s.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select name="assignedUser" class="form-select">
                    <option value="">All Owners</option>
                    @foreach (var u in Model.AvailableUsers)
                    {
                        <option value="@u.Value" selected="@u.Selected">@u.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-outline-primary flex-grow-1">Filter</button>
                @if (!string.IsNullOrEmpty(Model.NameFilter) || !string.IsNullOrEmpty(Model.CompanyFilter) || !string.IsNullOrEmpty(Model.StatusFilter) || !string.IsNullOrEmpty(Model.AssignedUserFilter))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary" title="Reset Filters"><i class="bi bi-x-lg"></i></a>
                }
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small text-uppercase">
                    <tr>
                        <th>Code</th>
                        <th>Lead Name</th>
                        <th>Contact Info</th>
                        <th>Company</th>
                        <th>Status</th>
                        <th>Expected Value</th>
                        <th>Assigned To</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Leads.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-funnel fs-1 d-block mb-2"></i>
                                No lead records found matching the current search filters.
                            </td>
                        </tr>
                    }
                    @foreach (var lead in Model.Leads)
                    {
                        var statusBadge = lead.Status switch
                        {
                            "New" => "badge bg-info text-dark",
                            "Contacted" => "badge bg-primary",
                            "Qualified" => "badge bg-success",
                            "Unqualified" => "badge bg-warning text-dark",
                            "Converted" => "badge bg-purple text-white bg-dark",
                            "Lost" => "badge bg-danger",
                            _ => "badge bg-secondary"
                        };

                        <tr>
                            <td><code>@lead.LeadCode</code></td>
                            <td>
                                <a asp-action="Details" asp-route-id="@lead.LeadId" class="fw-semibold text-decoration-none">
                                    @lead.LeadName
                                </a>
                            </td>
                            <td>
                                <div class="small"><i class="bi bi-envelope me-1 text-muted"></i>@lead.Email</div>
                                <div class="small text-muted"><i class="bi bi-telephone me-1"></i>@lead.Phone</div>
                            </td>
                            <td>@(lead.CompanyName ?? "-")</td>
                            <td><span class="@statusBadge">@lead.Status</span></td>
                            <td class="fw-semibold text-success">@lead.ExpectedValue.ToString("C")</td>
                            <td><span class="small badge bg-light text-dark border">@(lead.AssignedTo ?? "-")</span></td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@lead.LeadId" class="btn btn-outline-secondary" title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @if (lead.Status != "Converted")
                                    {
                                        <a asp-action="Edit" asp-route-id="@lead.LeadId" class="btn btn-outline-primary" title="Edit Lead">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    }
                                    @if (lead.Status == "Qualified" && lead.ConvertedCustomerId == null)
                                    {
                                        <a asp-action="Convert" asp-route-id="@lead.LeadId" class="btn btn-success" title="Convert to Customer & Opportunity">
                                            <i class="bi bi-arrow-right-circle me-1"></i>Convert
                                        </a>
                                    }
                                    @if (lead.Status == "Converted" && lead.ConvertedCustomerId != null)
                                    {
                                        <a asp-controller="Customers" asp-action="Details" asp-route-id="@lead.ConvertedCustomerId" class="btn btn-outline-success" title="View Converted Customer">
                                            <i class="bi bi-person-check"></i>
                                        </a>
                                    }
                                    <a asp-action="Delete" asp-route-id="@lead.LeadId" class="btn btn-outline-danger" title="Mark Lost / Delete">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
