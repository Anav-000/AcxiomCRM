@model AcxiomCRM.ViewModels.LeadConvertViewModel
@{
    ViewData["Title"] = "Convert Lead";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="card shadow-sm border-0 border-top border-success border-4">
            <div class="card-header bg-white py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h4 class="fw-bold mb-0 text-success">
                            <i class="bi bi-arrow-right-circle-fill me-2"></i>Convert Lead to Customer
                        </h4>
                        <span class="text-muted small">Converting Lead: <strong>@Model.CustomerName</strong> (<code>@Model.LeadCode</code>)</span>
                    </div>
                    <a asp-action="Details" asp-route-id="@Model.LeadId" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-arrow-left me-1"></i>Cancel
                    </a>
                </div>
            </div>
            <div class="card-body p-4">
                <div asp-validation-summary="All" class="alert alert-danger py-2 small" role="alert" style="@(ViewData.ModelState.IsValid ? "display:none" : "")"></div>

                <form asp-action="Convert" asp-route-id="@Model.LeadId" method="post" id="convertForm">
                    <input type="hidden" asp-for="LeadId" />
                    <input type="hidden" asp-for="LeadCode" />

                    <!-- Section 1: Customer Data -->
                    <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">
                        <i class="bi bi-person-fill text-primary me-2"></i>1. Customer Account Details
                    </h5>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="CustomerName" class="form-label fw-semibold"></label>
                            <input asp-for="CustomerName" class="form-control" />
                            <span asp-validation-for="CustomerName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CompanyName" class="form-label fw-semibold"></label>
                            <input asp-for="CompanyName" class="form-control" />
                            <span asp-validation-for="CompanyName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold"></label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label fw-semibold"></label>
                            <input asp-for="Phone" class="form-control" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Address" class="form-label fw-semibold"></label>
                            <input asp-for="Address" class="form-control" placeholder="Office / Billing Address" />
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="City" class="form-label fw-semibold"></label>
                            <input asp-for="City" class="form-control" />
                            <span asp-validation-for="City" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="State" class="form-label fw-semibold"></label>
                            <input asp-for="State" class="form-control" />
                            <span asp-validation-for="State" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Section 2: Opportunity Options -->
                    <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">
                        <i class="bi bi-briefcase-fill text-warning me-2"></i>2. Opportunity Creation (Optional)
                    </h5>

                    <div class="form-check form-switch mb-3">
                        <input asp-for="CreateOpportunity" class="form-check-input" type="checkbox" id="toggleOpp" />
                        <label asp-for="CreateOpportunity" class="form-check-label fw-semibold"></label>
                    </div>

                    <div id="oppSection" class="row g-3 p-3 bg-light rounded border mb-4">
                        <div class="col-md-12">
                            <label asp-for="OpportunityName" class="form-label fw-semibold"></label>
                            <input asp-for="OpportunityName" class="form-control" />
                            <span asp-validation-for="OpportunityName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="OpportunityAmount" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="OpportunityAmount" class="form-control" type="number" step="0.01" min="0.01" />
                            </div>
                            <span asp-validation-for="OpportunityAmount" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="OpportunityProbability" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <input asp-for="OpportunityProbability" class="form-control" type="number" min="0" max="100" />
                                <span class="input-group-text">%</span>
                            </div>
                            <span asp-validation-for="OpportunityProbability" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="ExpectedCloseDate" class="form-label fw-semibold"></label>
                            <input asp-for="ExpectedCloseDate" class="form-control" type="date" />
                            <span asp-validation-for="ExpectedCloseDate" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <span class="text-muted small">
                            <i class="bi bi-shield-lock me-1"></i> Conversion and audit records will be committed atomically in a single transaction.
                        </span>
                        <div class="d-flex gap-2">
                            <a asp-action="Details" asp-route-id="@Model.LeadId" class="btn btn-outline-secondary">Cancel</a>
                            <button type="submit" class="btn btn-success px-4 fw-bold">
                                <i class="bi bi-check2-circle me-1"></i> Complete Conversion
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('toggleOpp').addEventListener('change', function() {
            document.getElementById('oppSection').style.display = this.checked ? 'flex' : 'none';
        });
    </script>
}
