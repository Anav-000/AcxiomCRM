@model AcxiomCRM.ViewModels.LeadDetailsViewModel
@{
    ViewData["Title"] = "Lead Details";
    var l = Model.Lead;
    var statusBadge = l.Status switch
    {
        "New" => "badge bg-info text-dark fs-6",
        "Contacted" => "badge bg-primary fs-6",
        "Qualified" => "badge bg-success fs-6",
        "Unqualified" => "badge bg-warning text-dark fs-6",
        "Converted" => "badge bg-dark fs-6",
        "Lost" => "badge bg-danger fs-6",
        _ => "badge bg-secondary fs-6"
    };
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">
            <i class="bi bi-funnel text-info me-2"></i>@l.LeadName
        </h2>
        <div class="d-flex gap-2 align-items-center">
            <span class="badge bg-secondary">@l.LeadCode</span>
            <span class="@statusBadge">@l.Status</span>
            <span class="text-muted small">&bull; Created @l.CreatedDate.ToString("yyyy-MM-dd")</span>
        </div>
    </div>
    <div class="d-flex gap-2">
        @if (Model.CanConvert)
        {
            <a asp-action="Convert" asp-route-id="@l.LeadId" class="btn btn-success">
                <i class="bi bi-arrow-right-circle-fill me-1"></i>Convert Lead
            </a>
        }
        @if (Model.CanEdit)
        {
            <a asp-action="Edit" asp-route-id="@l.LeadId" class="btn btn-primary">
                <i class="bi bi-pencil me-1"></i>Edit
            </a>
        }
        @if (l.Status == "Converted" && l.ConvertedCustomerId != null)
        {
            <a asp-controller="Customers" asp-action="Details" asp-route-id="@l.ConvertedCustomerId" class="btn btn-outline-success">
                <i class="bi bi-person-check me-1"></i>View Customer (#@l.ConvertedCustomerId)
            </a>
        }
        <a asp-action="Delete" asp-route-id="@l.LeadId" class="btn btn-outline-danger">
            <i class="bi bi-trash me-1"></i>Mark Lost / Delete
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Back
        </a>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3">
                <h5 class="fw-bold mb-0"><i class="bi bi-info-circle text-primary me-2"></i>Lead Information</h5>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">Lead Name</dt>
                    <dd class="col-sm-8 fw-semibold">@l.LeadName</dd>

                    <dt class="col-sm-4 text-muted">Company</dt>
                    <dd class="col-sm-8">@(l.CompanyName ?? "-")</dd>

                    <dt class="col-sm-4 text-muted">Email</dt>
                    <dd class="col-sm-8"><a href="mailto:@l.Email" class="text-decoration-none">@l.Email</a></dd>

                    <dt class="col-sm-4 text-muted">Phone</dt>
                    <dd class="col-sm-8">@l.Phone</dd>

                    <dt class="col-sm-4 text-muted">Lead Source</dt>
                    <dd class="col-sm-8"><span class="badge bg-light text-dark border">@(l.Source ?? "Unspecified")</span></dd>

                    <dt class="col-sm-4 text-muted">Expected Value</dt>
                    <dd class="col-sm-8 fw-bold text-success fs-5">@l.ExpectedValue.ToString("C")</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3">
                <h5 class="fw-bold mb-0"><i class="bi bi-shield-person text-info me-2"></i>Assignment & Lifecycle</h5>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">Assigned Owner</dt>
                    <dd class="col-sm-8"><span class="badge bg-primary">@(l.AssignedTo ?? "Unassigned")</span></dd>

                    <dt class="col-sm-4 text-muted">Current Status</dt>
                    <dd class="col-sm-8"><span class="@statusBadge">@l.Status</span></dd>

                    <dt class="col-sm-4 text-muted">Created Date</dt>
                    <dd class="col-sm-8">@l.CreatedDate.ToString("yyyy-MM-dd HH:mm:ss")</dd>

                    @if (l.ConvertedCustomerId != null)
                    {
                        <dt class="col-sm-4 text-muted">Converted Customer</dt>
                        <dd class="col-sm-8">
                            <a asp-controller="Customers" asp-action="Details" asp-route-id="@l.ConvertedCustomerId" class="fw-bold text-success">
                                Customer ID #@l.ConvertedCustomerId
                            </a>
                        </dd>
                    }
                </dl>
            </div>
        </div>
    </div>
</div>
