@model AcxiomCRM.ViewModels.ActivityDetailsViewModel
@{
    ViewData["Title"] = "Activity Details";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h4 class="card-title mb-0">@Model.Activity.Subject</h4>
                <div>
                    <span class="badge bg-secondary fs-6 me-1">@Model.Activity.ActivityType</span>
                    <span class="badge bg-success fs-6">@Model.Activity.Status</span>
                </div>
            </div>
            <div class="card-body p-4">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">Activity Date</dt>
                    <dd class="col-sm-8 fw-bold">@Model.Activity.ActivityDate.ToString("yyyy-MM-dd")</dd>

                    <dt class="col-sm-4 text-muted">Customer</dt>
                    <dd class="col-sm-8">@(Model.CustomerName ?? "None")</dd>

                    <dt class="col-sm-4 text-muted">Lead</dt>
                    <dd class="col-sm-8">@(Model.LeadName ?? "None")</dd>

                    <dt class="col-sm-4 text-muted">Opportunity</dt>
                    <dd class="col-sm-8">@(Model.OpportunityName ?? "None")</dd>

                    <dt class="col-sm-4 text-muted">Assigned User</dt>
                    <dd class="col-sm-8">@(Model.AssignedToName ?? "Unassigned")</dd>

                    <dt class="col-sm-4 text-muted">Description / Notes</dt>
                    <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Activity.Description) ? "—" : Model.Activity.Description)</dd>
                </dl>
            </div>
            <div class="card-footer bg-white py-3 d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
                <div>
                    <a asp-action="Edit" asp-route-id="@Model.Activity.ActivityId" class="btn btn-primary me-2">Edit</a>
                    <a asp-action="Delete" asp-route-id="@Model.Activity.ActivityId" class="btn btn-outline-danger">Delete</a>
                </div>
            </div>
        </div>
    </div>
</div>
