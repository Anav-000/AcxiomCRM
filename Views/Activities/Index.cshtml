@model AcxiomCRM.ViewModels.ActivityListViewModel
@{
    ViewData["Title"] = "Activities";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="h3 mb-0">Activity Log</h2>
        <span class="text-muted">Track calls, meetings, emails, and tasks</span>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i> Log Activity
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Filters -->
<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-3">
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Search Subject/Notes</label>
                <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search..." />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Activity Type</label>
                <select name="activityTypeFilter" asp-items="Model.TypeList" class="form-select">
                    <option value="">All Types</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Status</label>
                <select name="statusFilter" asp-items="Model.StatusList" class="form-select">
                    <option value="">All Statuses</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Date</label>
                <input type="date" name="dateFilter" value="@(Model.DateFilter?.ToString("yyyy-MM-dd"))" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Assigned User</label>
                <select name="assignedToFilter" asp-items="Model.UserList" class="form-select">
                    <option value="">All Users</option>
                </select>
            </div>
            <div class="col-md-1 d-flex align-items-end">
                <button type="submit" class="btn btn-outline-primary w-100">Filter</button>
            </div>
        </form>
    </div>
</div>

<!-- Table -->
<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Type</th>
                    <th>Subject</th>
                    <th>Related To</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th>Assigned To</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Activities.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">No activities found matching criteria.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model.Activities)
                    {
                        <tr>
                            <td>
                                @switch (item.ActivityType)
                                {
                                    case "Call":
                                        <span class="badge bg-primary"><i class="bi bi-telephone me-1"></i> Call</span>
                                        break;
                                    case "Meeting":
                                        <span class="badge bg-success"><i class="bi bi-people me-1"></i> Meeting</span>
                                        break;
                                    case "Email":
                                        <span class="badge bg-info text-dark"><i class="bi bi-envelope me-1"></i> Email</span>
                                        break;
                                    case "Task":
                                        <span class="badge bg-warning text-dark"><i class="bi bi-check2-square me-1"></i> Task</span>
                                        break;
                                    default:
                                        <span class="badge bg-secondary">@item.ActivityType</span>
                                        break;
                                }
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.ActivityId" class="fw-bold text-decoration-none">
                                    @item.Subject
                                </a>
                            </td>
                            <td>
                                @if (item.CustomerId.HasValue)
                                {
                                    <div><small class="text-muted">Customer:</small> <span>@item.CustomerName</span></div>
                                }
                                @if (item.LeadId.HasValue)
                                {
                                    <div><small class="text-muted">Lead:</small> <span>@item.LeadName</span></div>
                                }
                                @if (item.OpportunityId.HasValue)
                                {
                                    <div><small class="text-muted">Opp:</small> <span>@item.OpportunityName</span></div>
                                }
                                @if (!item.CustomerId.HasValue && !item.LeadId.HasValue && !item.OpportunityId.HasValue)
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                @item.ActivityDate.ToString("yyyy-MM-dd")
                            </td>
                            <td>
                                @switch (item.Status)
                                {
                                    case "Completed":
                                        <span class="badge bg-success">Completed</span>
                                        break;
                                    case "Pending":
                                        <span class="badge bg-warning text-dark">Pending</span>
                                        break;
                                    case "Cancelled":
                                        <span class="badge bg-secondary">Cancelled</span>
                                        break;
                                    default:
                                        <span class="badge bg-light text-dark border">@item.Status</span>
                                        break;
                                }
                            </td>
                            <td>
                                <small>@item.AssignedToName</small>
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@item.ActivityId" class="btn btn-outline-info" title="Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.ActivityId" class="btn btn-outline-primary" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.ActivityId" class="btn btn-outline-danger" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
