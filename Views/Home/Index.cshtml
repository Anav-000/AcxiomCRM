@{
    ViewData["Title"] = "AcxiomCRM Enterprise Platform";
}

<div class="p-5 mb-4 bg-white rounded-3 shadow-sm border mt-3">
    <div class="container-fluid py-3">
        <div class="d-flex align-items-center mb-3">
            <i class="bi bi-diagram-3-fill text-primary fs-1 me-3"></i>
            <div>
                <h1 class="display-5 fw-bold mb-0">AcxiomCRM</h1>
                <p class="text-muted fs-5 mb-0">Customer Relationship & Sales Pipeline Management Platform</p>
            </div>
        </div>
        <p class="col-md-9 fs-5 text-secondary">
            Enterprise CRM system built with ASP.NET Core MVC, Razor, Bootstrap, ASP.NET Core Identity, and EF Core with SQLite.
            Phase 1 provides a complete core architecture, authentication, role-based authorization, audit logging, and dashboard shell.
        </p>
        <div class="d-flex gap-3 mt-4">
            <a class="btn btn-primary btn-lg px-4" asp-controller="Account" asp-action="Login">
                <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
            </a>
            <a class="btn btn-outline-secondary btn-lg px-4" asp-controller="Account" asp-action="Register">
                <i class="bi bi-person-plus me-2"></i>Register New Account
            </a>
            <a class="btn btn-outline-primary btn-lg px-4" asp-controller="Dashboard" asp-action="Index">
                <i class="bi bi-speedometer2 me-2"></i>Protected Dashboard
            </a>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm p-3">
            <div class="card-body">
                <div class="text-primary fs-2 mb-2"><i class="bi bi-shield-lock"></i></div>
                <h5 class="fw-bold">Security & Identity</h5>
                <p class="text-muted small">
                    PBKDF2 password hashing, 8+ character complexity rules, 5-attempt account lockout, and anti-forgery protection on all forms.
                </p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm p-3">
            <div class="card-body">
                <div class="text-success fs-2 mb-2"><i class="bi bi-person-gear"></i></div>
                <h5 class="fw-bold">Three Role Hierarchy</h5>
                <p class="text-muted small">
                    Admin, Manager, and SalesExecutive roles with role-based navigation and scoping. Public registration assigns SalesExecutive.
                </p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm p-3">
            <div class="card-body">
                <div class="text-danger fs-2 mb-2"><i class="bi bi-journal-text"></i></div>
                <h5 class="fw-bold">Security & Audit Trail</h5>
                <p class="text-muted small">
                    Append-only audit logs capturing successful login, failed login, account lockout, registration, and logout events with timestamp and IP.
                </p>
            </div>
        </div>
    </div>
</div>
