<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AcxiomCRM</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AcxiomCRM.styles.css" asp-append-version="true" />
</head>
<body class="bg-light d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
            <div class="container-fluid px-4">
                <a class="navbar-brand fw-bold text-uppercase d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-diagram-3-fill text-primary me-2 fs-4"></i>AcxiomCRM
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain"
                        aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white px-3" asp-controller="Dashboard" asp-action="Index">
                                    <i class="bi bi-speedometer2 me-1"></i>Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white px-3" asp-controller="Customers" asp-action="Index">
                                    <i class="bi bi-people me-1"></i>Customers
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white px-3" asp-controller="Leads" asp-action="Index">
                                    <i class="bi bi-funnel me-1"></i>Leads
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white px-3" asp-controller="Opportunities" asp-action="Index">
                                    <i class="bi bi-briefcase me-1"></i>Opportunities
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white px-3" asp-controller="FollowUps" asp-action="Index">
                                    <i class="bi bi-calendar-check me-1"></i>Follow-Ups
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white px-3" asp-controller="Activities" asp-action="Index">
                                    <i class="bi bi-list-task me-1"></i>Activities
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-white px-3" asp-controller="Reports" asp-action="Index">
                                    <i class="bi bi-graph-up me-1"></i>Reports
                                </a>
                            </li>

                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-warning px-3" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-shield-lock me-1"></i>Administration
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-dark" aria-labelledby="adminDropdown">
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Users"><i class="bi bi-person-gear me-2"></i>User Management</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Roles"><i class="bi bi-shield-check me-2"></i>Roles & Permissions</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="AuditLogs"><i class="bi bi-journal-text me-2"></i>System Audit Logs</a></li>
                                    </ul>
                                </li>
                            }
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Home" asp-action="Index">Home</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white-50" asp-controller="Home" asp-action="Privacy">Privacy</a>
                            </li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid px-4 py-4 flex-grow-1">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="bg-white border-top py-3 mt-auto">
        <div class="container-fluid px-4 text-center text-muted small">
            &copy; 2026 - <strong>AcxiomCRM</strong> | Enterprise Sales & Customer Relationship Management.
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
