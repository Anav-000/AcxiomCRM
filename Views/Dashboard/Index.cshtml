@model AcxiomCRM.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var roleBadge = Model.RoleName switch
    {
        "Admin" => "badge bg-danger fs-6",
        "Manager" => "badge bg-warning text-dark fs-6",
        "SalesExecutive" => "badge bg-primary fs-6",
        _ => "badge bg-secondary fs-6"
    };
    var scopeDescription = Model.RoleName switch
    {
        "Admin" => "Global Administrator Scope (All CRM Records, Users, Roles & Audits)",
        "Manager" => "Management Scope (Team CRM Records, Pipeline & Reports)",
        "SalesExecutive" => "Sales Specialist Scope (Assigned Records Only)",
        _ => "Standard User Access"
    };
}

<!-- Welcome Header & Scope Info -->
<div class="row mb-3">
    <div class="col-12">
        <div class="card shadow-sm border-0 bg-white">
            <div class="card-body p-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                <div>
                    <h3 class="fw-bold mb-1">
                        <i class="bi bi-speedometer2 text-primary me-2"></i>Welcome, @Model.UserFullName!
                    </h3>
                    <div class="d-flex align-items-center flex-wrap gap-2 mt-2">
                        <span class="@roleBadge">@Model.RoleName</span>
                        <span class="text-muted small">@Model.Email</span>
                        <span class="text-muted small">&bull;</span>
                        <span class="badge bg-light text-secondary border">@scopeDescription</span>
                    </div>
                </div>
                <div class="d-flex gap-2 align-items-center">
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2">
                        <i class="bi bi-shield-lock-fill me-1"></i> Authorized Scope Active
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Date Filter Toolbar (Section 17.11) -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body py-3">
        <form method="get" asp-action="Index" id="dashboardFilterForm" class="row g-2 align-items-center">
            <div class="col-auto">
                <span class="text-muted small fw-semibold me-2"><i class="bi bi-funnel me-1"></i>Filter Period:</span>
                <div class="btn-group btn-group-sm" role="group">
                    <a asp-action="Index" asp-route-dateFilter="All" class="btn @(Model.DateFilter == "All" ? "btn-primary" : "btn-outline-secondary")">All Time</a>
                    <a asp-action="Index" asp-route-dateFilter="Today" class="btn @(Model.DateFilter == "Today" ? "btn-primary" : "btn-outline-secondary")">Today</a>
                    <a asp-action="Index" asp-route-dateFilter="ThisWeek" class="btn @(Model.DateFilter == "ThisWeek" ? "btn-primary" : "btn-outline-secondary")">This Week</a>
                    <a asp-action="Index" asp-route-dateFilter="ThisMonth" class="btn @(Model.DateFilter == "ThisMonth" ? "btn-primary" : "btn-outline-secondary")">This Month</a>
                </div>
            </div>
            <input type="hidden" name="dateFilter" value="Custom" id="filterModeInput" />
            <div class="col-auto d-flex align-items-center gap-2 ms-md-auto">
                <span class="small text-muted">Custom:</span>
                <input type="date" name="startDate" value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" style="width: 140px;" />
                <span class="small text-muted">to</span>
                <input type="date" name="endDate" value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" style="width: 140px;" />
                <button type="submit" class="btn btn-sm btn-outline-primary" onclick="document.getElementById('filterModeInput').value='Custom'">Apply</button>
                @if (Model.DateFilter != "All")
                {
                    <a asp-action="Index" class="btn btn-sm btn-link text-muted">Reset</a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Mandatory KPI Cards (Section 17.11) -->
<div class="row g-3 mb-4">
    <!-- 1. Total Customers -->
    <div class="col-sm-6 col-xl-4 col-xxl-3">
        <div class="card shadow-sm border-0 border-start border-primary border-4 h-100">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small text-uppercase fw-semibold">Total Customers</div>
                        <div class="fs-3 fw-bold text-dark mt-1">@Model.TotalCustomers</div>
                    </div>
                    <div class="p-3 bg-primary-subtle text-primary rounded-circle">
                        <i class="bi bi-people-fill fs-4"></i>
                    </div>
                </div>
                <div class="text-muted small mt-2">
                    <a asp-controller="Customers" asp-action="Index" class="text-decoration-none text-primary">View Customers &rarr;</a>
                </div>
            </div>
        </div>
    </div>

    <!-- 2. Total Leads -->
    <div class="col-sm-6 col-xl-4 col-xxl-3">
        <div class="card shadow-sm border-0 border-start border-info border-4 h-100">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small text-uppercase fw-semibold">Total Leads</div>
                        <div class="fs-3 fw-bold text-dark mt-1">@Model.TotalLeads</div>
                    </div>
                    <div class="p-3 bg-info-subtle text-info rounded-circle">
                        <i class="bi bi-funnel-fill fs-4"></i>
                    </div>
                </div>
                <div class="text-muted small mt-2">
                    <span class="fw-semibold text-info">@Model.OpenLeads</span> open leads active
                </div>
            </div>
        </div>
    </div>

    <!-- 3. Open Leads -->
    <div class="col-sm-6 col-xl-4 col-xxl-3">
        <div class="card shadow-sm border-0 border-start border-cyan border-4 h-100" style="border-left-color: #0dcaf0 !important;">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small text-uppercase fw-semibold">Open Leads</div>
                        <div class="fs-3 fw-bold text-dark mt-1">@Model.OpenLeads</div>
                    </div>
                    <div class="p-3 bg-info-subtle text-info rounded-circle">
                        <i class="bi bi-lightning-charge-fill fs-4"></i>
                    </div>
                </div>
                <div class="text-muted small mt-2">
                    <a asp-controller="Leads" asp-action="Index" class="text-decoration-none text-info">Manage Leads &rarr;</a>
                </div>
            </div>
        </div>
    </div>

    <!-- 4. Total Opportunities -->
    <div class="col-sm-6 col-xl-4 col-xxl-3">
        <div class="card shadow-sm border-0 border-start border-warning border-4 h-100">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small text-uppercase fw-semibold">Total Opportunities</div>
                        <div class="fs-3 fw-bold text-dark mt-1">@Model.TotalOpportunities</div>
                    </div>
                    <div class="p-3 bg-warning-subtle text-warning rounded-circle">
                        <i class="bi bi-briefcase-fill fs-4"></i>
                    </div>
                </div>
                <div class="text-muted small mt-2">
                    <span class="fw-semibold text-warning">@Model.OpenOpportunities</span> open pipeline deals
                </div>
            </div>
        </div>
    </div>

    <!-- 5. Open Opportunities -->
    <div class="col-sm-6 col-xl-4 col-xxl-3">
        <div class="card shadow-sm border-0 border-start border-primary border-4 h-100">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small text-uppercase fw-semibold">Open Opportunities</div>
                        <div class="fs-3 fw-bold text-dark mt-1">@Model.OpenOpportunities</div>
                    </div>
                    <div class="p-3 bg-primary-subtle text-primary rounded-circle">
                        <i class="bi bi-pie-chart-fill fs-4"></i>
                    </div>
                </div>
                <div class="text-muted small mt-2">
                    <a asp-controller="Opportunities" asp-action="Index" asp-route-status="Open" class="text-decoration-none text-primary">View Open Deals &rarr;</a>
                </div>
            </div>
        </div>
    </div>

    <!-- 6. Won Opportunities -->
    <div class="col-sm-6 col-xl-4 col-xxl-3">
        <div class="card shadow-sm border-0 border-start border-success border-4 h-100">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small text-uppercase fw-semibold">Won Opportunities</div>
                        <div class="fs-3 fw-bold text-success mt-1">@Model.WonOpportunities</div>
                    </div>
                    <div class="p-3 bg-success-subtle text-success rounded-circle">
                        <i class="bi bi-trophy-fill fs-4"></i>
                    </div>
                </div>
                <div class="text-muted small mt-2">
                    <span class="text-success"><i class="bi bi-check-lg me-1"></i>Closed Won</span>
                </div>
            </div>
        </div>
    </div>

    <!-- 7. Lost Opportunities -->
    <div class="col-sm-6 col-xl-4 col-xxl-3">
        <div class="card shadow-sm border-0 border-start border-danger border-4 h-100">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small text-uppercase fw-semibold">Lost Opportunities</div>
                        <div class="fs-3 fw-bold text-danger mt-1">@Model.LostOpportunities</div>
                    </div>
                    <div class="p-3 bg-danger-subtle text-danger rounded-circle">
                        <i class="bi bi-x-octagon-fill fs-4"></i>
                    </div>
                </div>
                <div class="text-muted small mt-2">
                    <span class="text-danger"><i class="bi bi-dash-circle me-1"></i>Closed Lost</span>
                </div>
            </div>
        </div>
    </div>

    <!-- 8. Total Pipeline Value -->
    <div class="col-sm-6 col-xl-4 col-xxl-3">
        <div class="card shadow-sm border-0 border-start border-success border-4 h-100">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small text-uppercase fw-semibold">Pipeline Value</div>
                        <div class="fs-3 fw-bold text-success mt-1">@Model.TotalPipelineValue.ToString("C")</div>
                    </div>
                    <div class="p-3 bg-success-subtle text-success rounded-circle">
                        <i class="bi bi-currency-dollar fs-4"></i>
                    </div>
                </div>
                <div class="text-muted small mt-2">
                    <span class="text-muted">Eligible Open Amount</span>
                </div>
            </div>
        </div>
    </div>

    <!-- 9. Pending Follow-Ups -->
    <div class="col-sm-6 col-xl-4 col-xxl-3">
        <div class="card shadow-sm border-0 border-start border-secondary border-4 h-100">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small text-uppercase fw-semibold">Pending Follow-Ups</div>
                        <div class="fs-3 fw-bold text-dark mt-1">@Model.PendingFollowUps</div>
                    </div>
                    <div class="p-3 bg-secondary-subtle text-secondary rounded-circle">
                        <i class="bi bi-calendar-check fs-4"></i>
                    </div>
                </div>
                <div class="text-muted small mt-2">
                    <a asp-controller="FollowUps" asp-action="Index" asp-route-statusFilter="Planned" class="text-decoration-none text-secondary">Follow-Up Schedule &rarr;</a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Three Mandatory Chart.js Charts (Section 17.12) -->
<div class="row g-4 mb-4">
    <!-- Chart 1: Lead Status -->
    <div class="col-lg-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-pie-chart me-2 text-primary"></i>Lead Status Breakdown
                </h6>
            </div>
            <div class="card-body d-flex flex-column justify-content-center align-items-center p-3">
                <div style="position: relative; width: 100%; max-height: 260px;">
                    <canvas id="leadStatusChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Chart 2: Opportunity Pipeline by Stage -->
    <div class="col-lg-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-bar-chart-steps me-2 text-warning"></i>Opportunity Pipeline by Stage
                </h6>
            </div>
            <div class="card-body p-3">
                <div style="position: relative; width: 100%; max-height: 260px;">
                    <canvas id="opportunityPipelineChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Chart 3: Monthly Sales / Won Revenue -->
    <div class="col-lg-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-graph-up me-2 text-success"></i>Monthly Closed Won Revenue
                </h6>
            </div>
            <div class="card-body p-3">
                <div style="position: relative; width: 100%; max-height: 260px;">
                    <canvas id="monthlySalesChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Admin Recent Audit Logs Section (if Admin) -->
@if (Model.RoleName == "Admin" && Model.RecentAuditLogs.Any())
{
    <div class="card shadow-sm border-0 mb-4" id="audit-log-section">
        <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
            <h6 class="fw-bold mb-0 text-dark">
                <i class="bi bi-journal-text me-2 text-danger"></i>Recent System Audit Activity (Administrator)
            </h6>
            <a asp-controller="Admin" asp-action="AuditLogs" class="btn btn-sm btn-outline-danger">All Audit Logs &rarr;</a>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 small">
                <thead class="table-light">
                    <tr>
                        <th>Timestamp (UTC)</th>
                        <th>Action</th>
                        <th>Entity</th>
                        <th>Record ID</th>
                        <th>Details</th>
                        <th>IP Address</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model.RecentAuditLogs)
                    {
                        <tr>
                            <td>@a.CreatedDate.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td><span class="badge bg-secondary">@a.Action</span></td>
                            <td><span class="badge bg-light text-dark border">@a.EntityName</span></td>
                            <td>@a.RecordId</td>
                            <td class="text-truncate" style="max-width: 320px;">@(a.NewValue ?? a.OldValue ?? "—")</td>
                            <td><code>@(a.IpAddress ?? "127.0.0.1")</code></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@section Scripts {
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // 1. Lead Status Doughnut Chart
            const leadStatusCtx = document.getElementById('leadStatusChart').getContext('2d');
            new Chart(leadStatusCtx, {
                type: 'doughnut',
                data: {
                    labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LeadStatusLabels)),
                    datasets: [{
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LeadStatusCounts)),
                        backgroundColor: ['#0d6efd', '#0dcaf0', '#198754', '#dc3545', '#6c757d'],
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom', labels: { boxWidth: 12, font: { size: 11 } } }
                    }
                }
            });

            // 2. Opportunity Pipeline by Stage Bar Chart
            const oppPipelineCtx = document.getElementById('opportunityPipelineChart').getContext('2d');
            new Chart(oppPipelineCtx, {
                type: 'bar',
                data: {
                    labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PipelineStageLabels)),
                    datasets: [{
                        label: 'Count',
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PipelineStageCounts)),
                        backgroundColor: '#ffc107',
                        borderRadius: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: { beginAtZero: true, ticks: { stepSize: 1 } }
                    },
                    plugins: {
                        legend: { display: false }
                    }
                }
            });

            // 3. Monthly Sales / Won Revenue Line Chart
            const monthlySalesCtx = document.getElementById('monthlySalesChart').getContext('2d');
            new Chart(monthlySalesCtx, {
                type: 'line',
                data: {
                    labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlySalesLabels)),
                    datasets: [{
                        label: 'Won Revenue ($)',
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlySalesAmounts)),
                        borderColor: '#198754',
                        backgroundColor: 'rgba(25, 135, 84, 0.15)',
                        fill: true,
                        tension: 0.3,
                        pointRadius: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: { beginAtZero: true }
                    },
                    plugins: {
                        legend: { display: false }
                    }
                }
            });
        });
    </script>
}
